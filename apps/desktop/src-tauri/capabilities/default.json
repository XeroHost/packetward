{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the main window. No shell, no filesystem, no remote content.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://xerohost.net" }, { "url": "https://xerohost.net/*" },
        { "url": "https://npcap.com" },
        { "url": "https://npcap.com/*" }
      ]
    }
  ]
}
