{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "XeroHost",
    "license": "LicenseRef-PolyForm-Shield-1.0.0",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://xerohost.net",
    "copyright": "Copyright (c) 2026 XeroGroup LLC (XeroHost). Licensed under PolyForm Shield 1.0.0.",
    "shortDescription": "PacketWard network defense and diagnostics",
    "resources": {
      "../../../target/release/packetward-agent.exe": "packetward-agent.exe",
      "../../../target/release/pwctl.exe": "pwctl.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Spanish", "PortugueseBR"],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh"
      }
    }
